# Copy to /etc/ieee/backend.env on EC2; keep that file private.
BACKEND_IMAGE=registry.example.com/ieee-backend:replace-with-commit-sha
DB_USERNAME=ieee_app
DB_PASSWORD=replace-on-server
DB_URL=jdbc:mysql://db.example.internal:3306/ieee_db?sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/run/secrets/rds-truststore.p12&trustCertificateKeyStorePassword=changeit
